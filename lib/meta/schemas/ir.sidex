/// An arbitrary, schema-validated Sidex value.
///
/// Used by [`typed_attrs`] to carry the parsed result of a plugin's typed
/// attribute schema. Each codegen target maps `Value` to its language's
/// "any" type (e.g., `serde_json::Value` in Rust, `unknown` in TypeScript,
/// `typing.Any` in Python). Producers and consumers communicate through
/// JSON shape, validated at IR build time against the plugin's Sidex schema.
#[rust(type = "::serde_json::Value")]
opaque Value

/// Uniquely identifies a source in an IR.
#[rust(derive(Copy, PartialEq, Eq, Hash))]
wrapper SourceIdx: idx

/// Uniquely identifies a bundle in an IR.
#[rust(derive(Copy, PartialEq, Eq, Hash))]
wrapper BundleIdx: idx

/// Uniquely identifies a schema in an IR.
#[rust(derive(Copy, PartialEq, Eq, Hash))]
wrapper SchemaIdx: idx

/// Uniquely identifies a definition in an IR.
#[rust(derive(Copy, PartialEq, Eq, Hash))]
wrapper DefIdx: idx

/// Uniquely identifies a type variable in a definition.
#[rust(derive(Copy, PartialEq, Eq, Hash))]
wrapper TypeVarIdx: idx

/// References a definition.
#[rust(derive(Copy, PartialEq, Eq, Hash))]
record DefRef {
    /// The bundle containing the definition.
    bundle: BundleIdx,
    /// The schema containing the definition.
    schema: SchemaIdx,
    /// The definition.
    def: DefIdx,
}

/// Sidex IR — a fully-resolved, mostly-processed representation that
/// downstream code generators consume.
///
/// Every [`DefRef`] reachable from the IR resolves to a real entry in
/// [`Ir.defs`]. Codegens walk this graph without needing to think about
/// names, imports, or version constraints — those concerns are handled
/// before the IR is built.
#[rust(attr(non_exhaustive))]
record Ir {
    /// The bundles of the IR.
    #[default]
    bundles: [Bundle],
    /// The schemas of the IR.
    #[default]
    schemas: [Schema],
    /// The definitions of the IR.
    #[default]
    defs: [Def],
    /// The sources of the IR.
    #[default]
    sources: [Source],
    /// The bundle this IR was assembled around. Codegens typically only
    /// emit code for definitions belonging to schemas in this bundle.
    root: BundleIdx,
}

/// A *source* is a chunk of text.
#[rust(attr(non_exhaustive))]
record Source {
    /// The origin of the source, e.g., a filesystem path.
    origin?: string,
    /// The optional text of the source.
    ///
    /// This field is optional to allow for programmatically generated schemas.
    text?: string,
}

/// A bundle is a flat collection of schemas evolving together.
#[rust(attr(non_exhaustive))]
record Bundle {
    /// The metadata of the bundle.
    metadata: Metadata,
    /// The schemas of the bundle.
    #[default]
    schemas: [SchemaIdx],
    /// Whether the bundle is internal to the compiler.
    ///
    /// Internal bundles (the standard library, plugin attribute schemas
    /// auto-loaded by the compiler) are loaded automatically alongside any
    /// user bundle so that the typed-attrs parser can validate plugin
    /// attributes. Code generators should usually skip them since their
    /// defs are not part of the user's API surface.
    #[default]
    is_internal: bool,
}

/// Metadata of a bundle.
#[rust(attr(non_exhaustive))]
record Metadata {
    /// The name of the bundle.
    name: string,
    /// The version of the bundle.
    version: string,
    /// The optional description of the bundle.
    description?: string,
    /// The optional authors of the bundle.
    authors?: [string],
}

/// An *identifier* with an optional span.
record Ident {
    /// The identifier.
    name: string,
    /// The optional span of the identifier.
    span?: Span,
}

/// Documentation attached to an item.
record Docs {
    /// The text of the documentation.
    text: string,
}

/// A schema is a collection of definitions.
#[rust(attr(non_exhaustive))]
record Schema {
    /// The bundle the schema is part of.
    bundle: BundleIdx,
    /// The name of the schema.
    name: string,
    /// The documentation of the schema.
    docs?: Docs,
    /// The attributes of the schema.
    #[default]
    attrs: [Attr],
    /// The parsed, schema-validated attributes, keyed by plugin id.
    /// Populated by the compiler for plugins whose attribute schemas are
    /// loaded; raw [`attrs`] remains the round-trip form for unknown plugins.
    #[default]
    typed_attrs: [string: Value],
    /// The definitions of the schema.
    #[default]
    defs: [DefIdx],
    /// Names visible in the schema's namespace, keyed by the local name
    /// each entry is reachable as. Includes same-schema defs, imports
    /// (including wildcard expansions), and the implicit `core::builtins`
    /// defs. Mirrors the table the resolver consults at build time so
    /// post-build passes (typed-attrs `TypeRef` resolution, lints) can
    /// look up a name without re-parsing the imports.
    #[default]
    imports: [string: ImportTarget],
    /// The source of the schema.
    source?: SourceIdx,
    /// The optional span of the schema.
    span?: Span,
}

/// What a name in a schema's [`imports`] table resolves to.
#[json(tagged = internally)]
variant ImportTarget {
    /// Another bundle, e.g. `import other_bundle`.
    Bundle: BundleIdx,
    /// A schema in some bundle, e.g. `import bundle::module`.
    Schema: SchemaIdx,
    /// A definition, e.g. `import bundle::module::Foo` or any wildcard
    /// expansion that pulled `Foo` in.
    Def: DefRef,
}

/// A definition.
#[rust(attr(non_exhaustive))]
record Def {
    /// The schema the definition belongs to.
    schema: SchemaIdx,
    /// The name of the definition.
    name: Ident,
    /// The documentation of the definition.
    docs?: Docs,
    /// The type variables of the definition.
    #[default]
    vars: [TypeVar],
    /// The attributes of the definition.
    #[default]
    attrs: [Attr],
    /// The parsed, schema-validated attributes, keyed by plugin id.
    #[default]
    typed_attrs: [string: Value],
    /// The kind of the definition.
    kind: DefKind,
    /// The optional span of the definition.
    span?: Span,
}

/// A type variable of a definition.
#[rust(attr(non_exhaustive))]
record TypeVar {
    /// The name of the type variable.
    name: Ident,
}

/// A definition kind.
#[json(tagged = internally)]
variant DefKind {
    /// Definition of a type alias.
    TypeAlias: TypeAliasDef,
    /// Definition of an opaque type.
    OpaqueType: OpaqueTypeDef,
    /// Definition of a record type.
    RecordType: RecordTypeDef,
    /// Definition of a variant type.
    VariantType: VariantTypeDef,
    /// Definition of a wrapper type.
    WrapperType: WrapperTypeDef,
}

/// A definition of a type alias.
#[rust(attr(non_exhaustive))]
record TypeAliasDef {
    /// The type that is aliased.
    aliased: Type,
}

/// A definition of an opaque type.
#[rust(attr(non_exhaustive))]
record OpaqueTypeDef {}

/// A definition of a record type.
#[rust(attr(non_exhaustive))]
record RecordTypeDef {
    /// The fields of the record type.
    #[default]
    fields: [Field],
}

/// A field of a record type.
#[rust(attr(non_exhaustive))]
record Field {
    /// The name of the field.
    name: Ident,
    /// The documentation of the field.
    docs?: Docs,
    /// The attributes of the field.
    #[default]
    attrs: [Attr],
    /// The parsed, schema-validated attributes, keyed by plugin id.
    #[default]
    typed_attrs: [string: Value],
    /// The type of the field.
    typ: Type,
    /// Indicates whether the field is optional.
    #[default]
    is_optional: bool,
    /// The optional span of the field.
    span?: Span,
}

/// A definition of a variant type.
#[rust(attr(non_exhaustive))]
record VariantTypeDef {
    /// The variants of the variant type.
    #[default]
    variants: [Variant],
}

/// A variant of a variant type.
#[rust(attr(non_exhaustive))]
record Variant {
    /// The name of the variant.
    name: Ident,
    /// The documentation of the variant.
    docs?: Docs,
    /// The attributes of the variant.
    #[default]
    attrs: [Attr],
    /// The parsed, schema-validated attributes, keyed by plugin id.
    #[default]
    typed_attrs: [string: Value],
    /// The optional payload type of the variant.
    typ?: Type,
    /// The optional span of the variant.
    span?: Span,
}

/// A definition of a wrapper type.
#[rust(attr(non_exhaustive))]
record WrapperTypeDef {
    /// The type that is wrapped.
    wrapped: Type,
}

/// A type.
#[rust(attr(non_exhaustive))]
record Type {
    /// The kind of the type.
    kind: TypeKind,
    /// The span of the type expression.
    span?: Span,
}

/// An abstract type kind.
///
/// Built-in types like `[T]`, `[K: V]`, and `()` are represented as
/// instantiations of `core::builtins::Sequence`, `core::builtins::Map`,
/// and `core::builtins::unit`. There is no separate variant for them.
#[json(tagged = internally)]
variant TypeKind {
    /// A type to be determined via substitution of the respective type variable.
    TypeVar: TypeVarType,
    /// An instantiation of a type defined in some schema.
    Instance: InstanceType,
}

/// A type to be determined via substitution of the respective type variable.
#[rust(attr(non_exhaustive))]
record TypeVarType {
    /// The index of the type variable in the enclosing definition.
    idx: TypeVarIdx,
}

/// An instantiation of a type defined in some schema.
#[rust(attr(non_exhaustive))]
record InstanceType {
    /// The definition being instantiated.
    def: DefRef,
    /// Substitutions for the type variables of the definition.
    #[default]
    subst: [Type],
}

/// A *span* identifies a range of text in a source.
#[rust(derive(PartialEq, Eq, Hash), attr(non_exhaustive))]
record Span {
    /// The source.
    src: SourceIdx,
    /// The start character.
    start: idx,
    /// The included end character.
    end: idx,
}

/// An attribute.
#[rust(attr(non_exhaustive))]
record Attr {
    /// The kind of the attribute.
    kind: AttrKind,
    /// The span of the attribute.
    span?: Span,
}

/// The kinds of attributes.
#[json(tagged = internally)]
variant AttrKind {
    /// A bare `::`-separated path, e.g. `pub`.
    #[json(content = "path")]
    Path: string,
    /// A list attribute of the form `<PATH> ( <ARGS> )` where `<ARGS>` is a
    /// `,`-separated sequence of arguments.
    List: AttrList,
    /// An assign attribute of the form `<PATH> = <VALUE>`.
    Assign: AttrAssign,
    /// An anonymous (positional) value used as a list argument — e.g. the
    /// `{ … }` body in `#[validate({ 0 <= _ <= 100 })]`. Carries the value
    /// directly, with no path. The typed-attrs parser binds these to a
    /// designated schema field (the first field whose declared type is
    /// the [`core::attrs::Tokens`] marker, in source order).
    Value: AttrValue,
}

/// A list attribute of the form `<PATH> ( <ARGS> )`.
record AttrList {
    /// The path of the attribute.
    path: string,
    /// The arguments of the attribute.
    args: [Attr],
}

/// An assign attribute of the form `<PATH> = <VALUE>`.
record AttrAssign {
    /// The path of the attribute.
    path: string,
    /// The assigned value.
    value: AttrValue,
}

/// The value of an assign attribute.
#[json(tagged = internally)]
variant AttrValue {
    /// A boolean value.
    Bool: bool,
    /// A numeric value (kept as a string to avoid lossy conversion).
    Number: string,
    /// A string value.
    String: string,
    /// A `::`-separated path.
    Path: string,
    /// A `{ … }`-form value carrying source verbatim.
    ///
    /// Plugins that opt into this form (via a typed-attrs schema field of
    /// type `core::attrs::Tokens`) capture the source text and parse it
    /// with their own grammar — e.g. the validation extension's predicate
    /// expressions.
    Tokens: TokensValue,
}

/// A `{ … }`-form attribute value.
///
/// Carries the verbatim source text between the `{` and `}` (both excluded)
/// along with the span covering that text. Plugin codegens parse the text
/// with their own grammar.
#[rust(attr(non_exhaustive))]
record TokensValue {
    /// Verbatim source between the surrounding `{` and `}`, both excluded.
    text: string,
    /// Span of [`text`] within the originating source.
    span?: Span,
}
