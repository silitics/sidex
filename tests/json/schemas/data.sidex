record VariantTestRecord {
    a: u64,
    b?: string,
}

#[json(tag = "tagFieldName", content = "defaultContentField")]
variant VariantInternallyTagged<T> {
    A,
    B: u64,
    #[json(content = "specificContentField")]
    C: string,
    #[json(content = "content")]
    D: VariantTestRecord,
    E: VariantTestRecord,
    F: VarRecord<i32>,
    G: T,
    H: VarRecord<T>,
}

#[json(tagged = implicitly)]
variant VariantImplicitlyTagged<T> {
    A: u64,
    B: f64,
    C: string,
    D: [string],
    E: [string: u64],
    F: [string: f64],
    G: T,
}

#[json(tagged = externally)]
variant VariantExternallyTagged<T> {
    A,
    B: u64,
    C: VariantTestRecord,
    D: T,
}

#[json(
    tagged = adjacently,
    tag = "tagFieldName",
    content = "defaultContentField"
)]
variant VariantAdjacentlyTagged<T> {
    A,
    B: u64,
    #[json(content = "specificContentField")]
    C: string,
    #[json(content = "content")]
    D: VariantTestRecord,
    E: VariantTestRecord,
    F: T,
}

record RecordFieldNamesDefault {
    test_field_1: u64,
    test_field2: string,
}

#[json(rename_all = "SCREAMING_SNAKE_CASE")]
record RecordFieldNamesScreamingSnake {
    test_field_1: u64,
    test_field2: string,
}

record VarRecord<T> {
    x: T,
    y?: string,
}

#[json(tagged = implicitly)]
variant Any {
    Integer: i64,
    Float: f64,
    String: string,
    Bool: bool,
    Array: [Any],
    Object: [string: Any],
}

#[json(tagged = implicitly)]
variant MaybeRef<T> {
    Value: T,
    Reference: Reference,
}

record Reference {
    #[json(name = "$ref")]
    reference: string,
}

record Point {
    x: f64,
    y: f64,
}

/// Exercises encodings that don't roundtrip through JS via serde's defaults:
/// - `i64`/`u64` as decimal strings (JS `Number` loses precision past `2^53`),
/// - `f32`/`f64` non-finite values as `"NaN"` / `"+Infinity"` / `"-Infinity"`.
record JsRoundtrip {
    big_u: u64,
    neg_i: i64,
    finite_f: f64,
    non_finite_f: f64,
    optional_u?: u64,
    seq_u: [u64],
    map_u: [string: u64],
}
