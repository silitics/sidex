//! Cases that exercise each recognizer shape and the runtime helpers.

record User {
    #[validate({ 1 <= _.size <= 254 })]
    #[validate({ matches(_, "^[^@]+@[^@]+$") }, message = "Bad email.", code = "format:email")]
    email: string,

    #[validate({ 0 <= _ <= 150 })]
    age: u32,

    #[validate({ 1 <= _.size })]
    nickname?: string,
}

#[validate({ 1 <= _.size <= 64 })]
wrapper Slug: string

#[validate({ _.min <= _.max })]
record Range {
    min: i32,
    max: i32,
}

/// Record with no `#[validate]` rules — the plugin still emits a no-op
/// `Validate` impl so generic call sites can call `.validate()` uniformly.
record Empty {}
