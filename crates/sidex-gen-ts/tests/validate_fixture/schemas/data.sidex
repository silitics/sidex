//! Cases for the TS validate plugin.

record User {
    #[validate({ 1 <= _.size <= 254 }, message = "Email length is out of range.")]
    email: string,

    #[validate({ 0 <= _ <= 150 })]
    age: u32,

    #[validate({ 1 <= _.size })]
    nickname?: string,
}

#[validate({ 1 <= _.size <= 64 })]
wrapper Slug: string

record CodeOnly {
    #[validate({ matches(_, "^[A-Z]{2}-[0-9]{4}$") }, code = "format:order")]
    code: string,
}
