---
import { getCollection, render } from "astro:content";
import { DocsLayout } from "@silitics/astro-docs";
import { brand, nav, headerActions, getDocsConfig } from "../../site";
import SiteFooter from "../../layouts/SiteFooter.astro";

export async function getStaticPaths() {
  return (await getCollection("docs"))
    .filter((entry) => !entry.data.draft)
    .map((entry) => ({
      params: { slug: entry.id === "index" ? undefined : entry.id },
      props: { entry },
    }));
}

const { entry } = Astro.props;
const { Content, headings } = await render(entry);
const config = await getDocsConfig();
---

<DocsLayout
  brand={brand}
  nav={nav}
  actions={headerActions}
  config={config}
  versionSlug="main"
  pageSlug={entry.id}
  title={entry.data.title}
  description={entry.data.description}
  headings={headings}
>
  <Content />
  <SiteFooter slot="footer" />
</DocsLayout>
