{
	"name": "sidex",
	"displayName": "Sidex",
	"description": "Syntax highlighting for the Sidex data modeling and API definition language.",
	"version": "0.0.4",
	"publisher": "silitics",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "https://github.com/silitics/sidex.git"
	},
	"engines": {
		"vscode": "^1.69.0"
	},
	"categories": [
		"Programming Languages"
	],
	"contributes": {
		"languages": [
			{
				"id": "sidex",
				"aliases": [
					"Sidex"
				],
				"extensions": [
					".sidex"
				],
				"configuration": "./sidex-language-configuration.json"
			}
		],
		"grammars": [
			{
				"language": "sidex",
				"scopeName": "source.sidex",
				"path": "./sidex-grammar.tmGrammar.json"
			}
		]
	},
	"scripts": {
		"vsce:package": "vsce package"
	},
	"devDependencies": {
		"@vscode/vsce": "^3.9.1"
	}
}
