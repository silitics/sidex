{
  "name": "@sidex/validate",
  "version": "0.1.0",
  "description": "Runtime support for Sidex's validation extension.",
  "author": "Silitics GmbH <info@silitics.com>",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://oss.silitics.com/sidex",
  "repository": {
