{
  "name": "@sidex/types",
  "version": "0.4.1",
  "description": "Types of Sidex's built-in types in their JSON representation.",
  "author": "Silitics GmbH <info@silitics.com>",
  "license": "MIT OR Apache-2.0",
  "homepage": "https://oss.silitics.com/sidex",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/silitics/sidex.git",
    "directory": "languages/typescript/packages/types"
  },
  "type": "module",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "LICENSE-APACHE",
    "LICENSE-MIT"
  ],
  "sideEffects": false,
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc",
    "test": "tsc && node --experimental-strip-types --test tests/*.test.ts",
    "clean": "rm -rf dist",
    "prepare": "npm run build",
    "prepublishOnly": "npm run clean && npm run build"
  },
  "devDependencies": {
    "typescript": "^6.0.3"
  }
}
