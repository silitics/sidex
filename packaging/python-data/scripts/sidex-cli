#!python
"""Run the Sidex executable installed alongside this alias."""

import os
import sys
from pathlib import Path

binary = Path(__file__).resolve().parent / "sidex"
try:
    os.execv(binary, [str(binary), *sys.argv[1:]])
except OSError as error:
    raise SystemExit(
        f"Failed to run packaged Sidex: {error}. Reinstall sidex-cli."
    ) from error
